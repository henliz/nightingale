# "demo" (default): the in-browser story, no server needed.
# "api": read the latest drill session's ePCR, transcript and photos from packages/api
#        (start it with `pnpm --filter @nightingale/api dev`; vite proxies /api to :8787).
# `?source=api` or `?source=demo` on any url overrides this for the tab.
VITE_DATA_SOURCE=demo
# where vite proxies /api in dev (default http://localhost:8787)
# NIGHTINGALE_API_URL=http://localhost:8787
